  "checkpoint": {
    "save_dir": "runs/v4/S3_E3"
  },
  "ablation": {
    "name": "S3_E3",
    "axis": "pseudo_gt_pairing_v4",
    "stage": "v4_round",
    "notes": "E3 4×128 25% Feather（与 S2 同一基础配对集）"
  }
