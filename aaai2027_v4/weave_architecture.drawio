      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e_trunk_lh" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r2_trunk" target="r2_head_lh">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e_trunk_hl" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r2_trunk" target="r2_head_hl">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Heads to Euler -->
    <mxCell id="e_head_euler1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r2_head_ll" target="r2_euler">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="960" y="450" />
          <mxPoint x="960" y="580" />
          <mxPoint x="814" y="580" />
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="e_head_euler2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r2_head_lh" target="r2_euler">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="960" y="495" />
          <mxPoint x="960" y="580" />
          <mxPoint x="814" y="580" />
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="e_head_euler3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r2_head_hl" target="r2_euler">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="960" y="540" />
          <mxPoint x="960" y="580" />
          <mxPoint x="814" y="580" />
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Euler to iDWT -->
    <mxCell id="e_euler_idwt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r2_euler" target="r2_idwt">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="1000" y="635" />
          <mxPoint x="1000" y="490" />
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- iDWT to Stage B -->
    <mxCell id="e_idwt_adain" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r2_idwt" target="r2_stageB">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- Stage B Output / Loop Back -->
    <mxCell id="e_loop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="r2_stageB">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="490" y="580" as="targetPoint" />
        <Array as="points">
          <mxPoint x="1460" y="515" />
          <mxPoint x="1460" y="680" />
          <mxPoint x="490" y="680" />
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="lbl_loop_k" value="\(k=0,\dots,K-1 \quad (K=8)\)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Times New Roman;fontSize=12" vertex="1" parent="1">
      <mxGeometry x="840" y="680" width="180" height="20" as="geometry" />
    </mxCell>
    
    <!-- Final Output -->
    <mxCell id="e_dec_xhat" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="r2_dec" target="r2_xhat">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e_out_to_dec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" target="r2_dec">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="1460" y="490" as="sourcePoint" />
      </mxGeometry>
    </mxCell>
    <mxCell id="lbl_zk" value="\(z_K\)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Times New Roman;" vertex="1" parent="1">
      <mxGeometry x="1460" y="465" width="40" height="20" as="geometry" />
    </mxCell>

    <!-- ==================== ROW 3: TRAINING ONLY ==================== -->
    <mxCell id="r3_z" value="Content latent \(z_c\)&#xa;+&#xa;Target-style latent \(z_s\)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Times New Roman;" vertex="1" parent="1">
      <mxGeometry x="40" y="830" width="150" height="40" as="geometry" />
    </mxCell>

    <mxCell id="r3_endpoint" value="Source-aligned endpoint \(z_1^*\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Times New Roman;" vertex="1" parent="1">
      <mxGeometry x="240" y="830" width="190" height="40" as="geometry" />
    </mxCell>

    <mxCell id="r3_sample" value="Sample \(t\), \(\epsilon\)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Times New Roman;" vertex="1" parent="1">
      <mxGeometry x="450" y="830" width="90" height="40" as="geometry" />
    </mxCell>

    <mxCell id="r3_zt" value="Sample path state \(z_t\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Times New Roman;" vertex="1" parent="1">
      <mxGeometry x="560" y="790" width="160" height="40" as="geometry" />
    </mxCell>
    
    <mxCell id="r3_u" value="Clean target \(u = z_1^* - z_c\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Times New Roman;" vertex="1" parent="1">
      <mxGeometry x="560" y="870" width="170" height="40" as="geometry" />
    </mxCell>

    <mxCell id="r3_model" value="Shared Stage-A velocity model&#xa;\(v_\theta(z_t, t, s)\)&lt;br&gt;&lt;i&gt;(same weights as Stage A)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Times New Roman;" vertex="1" parent="1">
      <mxGeometry x="780" y="780" width="220" height="60" as="geometry" />
    </mxCell>

    <mxCell id="r3_wu" value="Haar DWT: \(W(u)\)&#xa;\(=(u_\ell, u_{h1}, u_{h2}, u_{h3})\)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Times New Roman;" vertex="1" parent="1">
      <mxGeometry x="780" y="860" width="220" height="60" as="geometry" />
    </mxCell>

    <mxCell id="r3_pred" value="Predicted \((v_\ell, v_{h1}, v_{h2})\)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Times New Roman;" vertex="1" parent="1">
      <mxGeometry x="1030" y="795" width="160" height="30" as="geometry" />
    </mxCell>
    
    <mxCell id="r3_target" value="Targets \((u_\ell, u_{h1}, u_{h2})\)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Times New Roman;" vertex="1" parent="1">
      <mxGeometry x="1030" y="875" width="160" height="30" as="geometry" />
    </mxCell>

    <mxCell id="r3_loss" value="&lt;font style=&#34;font-size: 16px;&#34;&gt;Routed subband loss \(L_{\text{SFM}}\)&lt;br&gt;&lt;b&gt;LL weighted; HH excluded&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Times New Roman;" vertex="1" parent="1">
      <mxGeometry x="1230" y="820" width="280" height="60" as="geometry" />
    </mxCell>

    <!-- Training Row Connections -->
    <mxCell id="e_r3_z_end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r3_z" target="r3_endpoint">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e_r3_end_split" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="r3_endpoint" target="r3_sample">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    
    <mxCell id="e_r3_sample_zt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r3_sample" target="r3_zt">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="540" y="850" />
          <mxPoint x="540" y="810" />
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="e_r3_sample_u" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r3_sample" target="r3_u">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="540" y="850" />
          <mxPoint x="540" y="890" />
        </Array>
      </mxGeometry>
    </mxCell>

    <mxCell id="e_r3_zt_model" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r3_zt" target="r3_model">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e_r3_u_wu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r3_u" target="r3_wu">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e_r3_model_pred" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r3_model" target="r3_pred">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e_r3_wu_target" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r3_wu" target="r3_target">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e_r3_pred_loss" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="r3_pred" target="r3_loss">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="1210" y="810" />
          <mxPoint x="1210" y="835" />
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="e_r3_target_loss" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="r3_target" target="r3_loss">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="1210" y="890" />
          <mxPoint x="1210" y="865" />
        </Array>
      </mxGeometry>
    </mxCell>

  </root>
</mxGraphModel>